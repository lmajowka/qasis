{
  "name": "qasis",
  "version": "0.0.1",
  "description": "Qasis — an agent that continuously QAs websites and generates reports.",
  "type": "module",
  "private": true,
  "bin": {
    "qasis-qa": "src/cli.mjs",
    "qasis-flows": "src/flows-cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node setup/index.mjs",
    "status": "node setup/index.mjs --status",
    "uninstall": "node setup/index.mjs --uninstall",
    "watch": "node setup/index.mjs --watch",
    "unwatch": "node setup/index.mjs --unwatch",
    "qa": "node src/cli.mjs",
    "flows": "node src/flows-cli.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
